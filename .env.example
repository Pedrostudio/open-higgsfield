# Higgsfield API origin (server only)
HF_API_BASE_URL=https://api.higgsfield.ai

# Futuru's Higgsfield API key as id:secret (server only). When set, the whole
# team generates on it and nobody enters a key in the browser.
HF_API_KEY=

# Team password for the sign-in page. Required in production: without it the
# studio refuses every request. Changing it signs everyone out.
STUDIO_PASSWORD=

# Vercel Blob read-write token, for uploading reference images, video and audio.
# Vercel sets it when a store is connected; OPEN_HIGGSFIELD_READ_WRITE_TOKEN
# is read first if you prefer the prefixed name.
BLOB_READ_WRITE_TOKEN=
